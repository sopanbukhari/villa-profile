# Database Connection Strings (Neon or Supabase PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Admin Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-length"

# Initial Admin Credentials (used during seed)
ADMIN_NAME="Villa Admin"
ADMIN_EMAIL="admin@villaparadise.com"
ADMIN_PASSWORD="SecureAdminPassword123!"

# WhatsApp Booking Target Number (International format without '+' or spaces, e.g. 6281234567890)
WHATSAPP_NUMBER="6281234567890"

# Application URLs & Port
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
