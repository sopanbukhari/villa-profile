datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  INQUIRY
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Admin {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String             @map("password_hash")
  name         String
  role         String             @default("ADMIN")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  statusLogs   BookingStatusLog[]
  blockedDates BlockedDate[]

  @@map("admins")
}

model Villa {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  tagline          String?
  description      String          @db.Text
  shortDescription String?         @map("short_description") @db.Text
  bedrooms         Int             @default(1)
  bathrooms        Int             @default(1)
  maxGuests        Int             @default(2) @map("max_guests")
  address          String
  city             String
  province         String
  postalCode       String?         @map("postal_code")
  mapUrl           String?         @map("map_url") @db.Text
  checkInTime      String          @default("14:00") @map("check_in_time")
  checkOutTime     String          @default("12:00") @map("check_out_time")
  basePriceIdr     Decimal         @map("base_price_idr") @db.Decimal(12, 2)
  weekendPriceIdr  Decimal?        @map("weekend_price_idr") @db.Decimal(12, 2)
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  images           VillaImage[]
  facilities       VillaFacility[]
  pricing          VillaPricing[]
  bookings         Booking[]
  blockedDates     BlockedDate[]

  @@map("villas")
}

model VillaImage {
  id           String   @id @default(uuid())
  villaId      String   @map("villa_id")
  villa        Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  url          String   @db.Text
  caption      String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([villaId])
  @@map("villa_images")
}

model VillaFacility {
  id          String   @id @default(uuid())
  villaId     String   @map("villa_id")
  villa       Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  name        String
  category    String   // e.g., "Living & Outdoor", "Bedroom & Bath", "Entertainment", "Kitchen & Dining", "Services"
  icon        String?  // Lucide icon identifier: "wifi", "waves", "tv", "wind", "utensils", "coffee", "sparkles", "shield-check", "car", "bath"
  description String?
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([villaId])
  @@map("villa_facilities")
}

model VillaPricing {
  id                String   @id @default(uuid())
  villaId           String   @map("villa_id")
  villa             Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  name              String   // e.g. "Peak Holiday Season", "Weekend Special", "Low Season"
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  pricePerNightIdr  Decimal  @map("price_per_night_idr") @db.Decimal(12, 2)
  minStayNights     Int      @default(1) @map("min_stay_nights")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([villaId, startDate, endDate])
  @@map("villa_pricing")
}

model Booking {
  id               String             @id @default(uuid())
  bookingReference String             @unique @map("booking_reference")
  villaId          String             @map("villa_id")
  villa            Villa              @relation(fields: [villaId], references: [id], onDelete: Cascade)
  customerName     String             @map("customer_name")
  customerEmail    String?            @map("customer_email")
  customerPhone    String             @map("customer_phone")
  checkIn          DateTime           @map("check_in") @db.Date
  checkOut         DateTime           @map("check_out") @db.Date
  totalNights      Int                @map("total_nights")
  guestCount       Int                @map("guest_count")
  baseRateIdr      Decimal            @map("base_rate_idr") @db.Decimal(12, 2)
  totalAmountIdr   Decimal            @map("total_amount_idr") @db.Decimal(12, 2)
  status           BookingStatus      @default(INQUIRY)
  expiresAt        DateTime?          @map("expires_at")
  specialRequests  String?            @map("special_requests") @db.Text
  adminNotes       String?            @map("admin_notes") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  statusLogs       BookingStatusLog[]

  @@index([villaId, checkIn, checkOut])
  @@index([status])
  @@index([bookingReference])
  @@map("bookings")
}

model BlockedDate {
  id          String   @id @default(uuid())
  villaId     String   @map("villa_id")
  villa       Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  reason      String?
  createdById String?  @map("created_by")
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([villaId, startDate, endDate])
  @@map("blocked_dates")
}

model BookingStatusLog {
  id             String         @id @default(uuid())
  bookingId      String         @map("booking_id")
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  changedById    String?        @map("changed_by")
  changedBy      Admin?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("booking_status_logs")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
